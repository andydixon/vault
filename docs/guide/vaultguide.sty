% ---------------------------------------------------------------- chapter banners
\newif\ifvappendix
\newcommand\vaultchaptercount{11}
\newcommand\vbanner[3]{% #1 label, #2 big mark, #3 title
  \begin{tikzpicture}[remember picture,overlay]
    \shade[left color=vnavy,right color=vink]
      (current page.north west) rectangle ([yshift=-72mm]current page.north east);
    \begin{scope}
      \clip (current page.north west) rectangle ([yshift=-72mm]current page.north east);
      \foreach \r in {14,24,34,44,54,64}
        \draw[vteal,opacity=0.13,line width=0.7pt]
          ([xshift=-34mm,yshift=-38mm]current page.north east) circle (\r mm);
      \foreach \a in {0,6,...,354}
        \draw[vteal,opacity=0.22,line width=0.5pt]
          ([xshift=-34mm,yshift=-38mm]current page.north east) ++(\a:44mm) -- ++(\a:3mm);
      \node[anchor=center,font=\displayblack\fontsize{96}{96}\selectfont,text=vteal]
        at ([xshift=-34mm,yshift=-38mm]current page.north east) {#2};
    \end{scope}
    \fill[vamber] ([yshift=-72mm]current page.north west) rectangle
      ([yshift=-73.4mm,xshift=62mm]current page.north west);
    \node[anchor=south west,font=\labelfont\scriptsize,text=vteal]
      at ([xshift=26mm,yshift=-27mm]current page.north west) {#1};
    \node[anchor=north west,text width=118mm,align=left,text=white,
      font={\display\fontsize{27}{31}\selectfont\hyphenpenalty=10000\exhyphenpenalty=10000}]
      at ([xshift=25.4mm,yshift=-30mm]current page.north west) {#3};
    \ifvappendix\else\ifnum\value{chapter}>0
      \foreach \i in {1,...,\vaultchaptercount}{
        \ifnum\i<\numexpr\value{chapter}+1\relax
          \fill[vteal] ([xshift=26mm+\i*5.2mm-5.2mm,yshift=-63mm]current page.north west) circle (1.5pt);
        \else
          \draw[vteal!60,line width=0.5pt] ([xshift=26mm+\i*5.2mm-5.2mm,yshift=-63mm]current page.north west) circle (1.5pt);
        \fi}
      \node[anchor=west,font=\scriptsize\color{white!60!vslate}]
        at ([xshift=26mm+\vaultchaptercount*5.2mm,yshift=-63mm]current page.north west)
        {you are here};
    \fi\fi
  \end{tikzpicture}%
  \par\vspace*{40mm}}
\newcommand\vchapterhead[1]{\ifvappendix\vbanner{APPENDIX \thechapter}{\thechapter}{#1}\else
  \vbanner{CHAPTER \thechapter\ \ /\ \ \vaultchaptercount}{\thechapter}{#1}\fi}
\titleformat{\chapter}[block]{}{}{0pt}{\vchapterhead}
\titleformat{name=\chapter,numberless}[block]{}{}{0pt}{\vbanner{THE VAULT FIELD GUIDE}{\faIcon{key}}}
\titlespacing*{\chapter}{0pt}{-14mm}{6mm}

\titleformat{\section}[hang]{\display\fontsize{16.5}{20}\selectfont\color{vink}}
  {\llap{\color{vteal}\thesection\hspace{0.65em}}}{0pt}{}
\titlespacing*{\section}{0pt}{18pt plus 4pt minus 2pt}{6pt}
\newcommand\vsubhead[1]{\llap{\color{vteal}\scriptsize\faIcon{square-full}\hspace{0.6em}}#1}
\titleformat{\subsection}[block]{\displaybold\fontsize{12}{15}\selectfont\color{vink}}
  {}{0pt}{\vsubhead}
\titlespacing*{\subsection}{0pt}{12pt plus 3pt}{3pt}
\setcounter{secnumdepth}{1}
\setcounter{tocdepth}{1}

% ---------------------------------------------------------------- contents
\titlecontents{chapter}[0pt]{\addvspace{9pt}\display\fontsize{12.5}{16}\selectfont\color{vink}}
  {\makebox[11mm][l]{\color{vteal}\thecontentslabel}}{}
  {\hfill\color{vtealdeep}\contentspage}
\titlecontents{section}[11mm]{\addvspace{1pt}\small\color{vtext}}
  {\makebox[10mm][l]{\color{vslate}\thecontentslabel}}{}
  {\color{vline}\titlerule*[0.55pc]{.}\color{vslate}\contentspage}
\newcommand\tagline[1]{\addtocontents{toc}{\protect\vspace{-1pt}\protect\hspace*{11mm}%
  {\protect\footnotesize\protect\itshape\protect\color{vslate}#1}\protect\par}}

% ---------------------------------------------------------------- cover
\newcommand\vaultdoor[2]{% #1 centre coordinate, #2 radius in mm
  \begin{scope}[shift={#1}]
    \foreach \g/\o in {1.42/0.035,1.3/0.05,1.2/0.07,1.12/0.09}
      \fill[vteal,opacity=\o] (0,0) circle (#2*\g mm);
    \fill[vink] (0,0) circle (#2 mm);
    \draw[vteal,line width=1.6pt] (0,0) circle (#2 mm);
    \draw[vteal!55,line width=0.5pt] (0,0) circle (#2*0.93 mm);
    \foreach \a in {0,3,...,357}
      \draw[vteal!70,line width=0.45pt] (\a:#2*0.93 mm) -- (\a:#2*0.885 mm);
    \foreach \a in {0,30,...,330}
      \draw[vteal,line width=1.1pt] (\a:#2*0.93 mm) -- (\a:#2*0.85 mm);
    \fill[vnavy] (0,0) circle (#2*0.76 mm);
    \draw[vteal!40,line width=0.6pt] (0,0) circle (#2*0.76 mm);
    \foreach \a in {22.5,67.5,...,337.5}
      {\fill[vink] (\a:#2*0.66 mm) circle (#2*0.055 mm);
       \draw[vteal!80,line width=0.6pt] (\a:#2*0.66 mm) circle (#2*0.055 mm);}
    \draw[vamber,line width=2.2pt,line cap=round] (0,0) circle (#2*0.34 mm);
    \foreach \a in {90,210,330}
      {\draw[white,line width=3.6pt,line cap=round] (\a:#2*0.1 mm) -- (\a:#2*0.5 mm);
       \fill[white] (\a:#2*0.5 mm) circle (#2*0.045 mm);}
    \fill[white] (0,0) circle (#2*0.12 mm);
    \fill[vamber] (0,0) circle (#2*0.055 mm);
  \end{scope}}

\newcommand\makecover{%
  \thispagestyle{empty}
  \begin{tikzpicture}[remember picture,overlay]
    \shade[top color=vink,bottom color=vnavy]
      (current page.north west) rectangle (current page.south east);
    % ciphertext rain
    \pgfmathsetseed{1789}
    \begin{scope}
      \clip (current page.north west) rectangle (current page.south east);
      \foreach \y in {0,...,58}{
        \pgfmathrandominteger{\off}{0}{60}
        \node[anchor=west,font=\ttfamily\fontsize{6.5}{6.5}\selectfont,text=vteal,opacity=0.075]
          at ([xshift=-\off mm,yshift=-\y*5.1mm-3mm]current page.north west)
          {9f3a c01d e55b 7a90 b4f2 0e6c d318 a7e4 52cb 11f0 8d6e 4ab9 e203 7c5f 96d1 3be8 f40a 6d27 c9b3 0a5e 71fd 2c84 be16 5903 d7aa 18e9 f36b 4c20 a95d};}
    \end{scope}
    \vaultdoor{($(current page.center)+(38mm,42mm)$)}{62}
    % title block
    \node[anchor=south west,font=\labelfontwide\small,text=vteal]
      at ([xshift=24mm,yshift=112mm]current page.south west) {THE FIELD GUIDE};
    \node[anchor=north west,font=\displayblack\fontsize{104}{104}\selectfont,text=white]
      at ([xshift=21mm,yshift=110mm]current page.south west) {vault};
    \fill[vamber] ([xshift=25mm,yshift=72mm]current page.south west) rectangle ++(34mm,1.6mm);
    \node[anchor=north west,text width=130mm,align=left,
      font=\lightfont\fontsize{17}{23}\selectfont,text=white!85!vteal]
      at ([xshift=24mm,yshift=66mm]current page.south west)
      {Post-quantum file encryption.\\ With a secret trapdoor.};
    \node[anchor=south west] at ([xshift=24mm,yshift=26mm]current page.south west)
      {\coverchip{\faIcon{shield-alt}}{FrodoKEM + ML-KEM}\hspace{2.5mm}%
       \coverchip{\faIcon{user-secret}}{decoy passphrase}\hspace{2.5mm}%
       \coverchip{\faIcon{microchip}}{one binary, 43 platforms}};
    \node[anchor=south east,font=\scriptsize\labelfont,text=white!55!vslate]
      at ([xshift=-22mm,yshift=14mm]current page.south east) {VERSION \vaultversion\ \ \textbullet\ \ \vaultdate};
    \node[anchor=south west,font=\footnotesize\itshape,text=white!55!vslate]
      at ([xshift=24mm,yshift=14mm]current page.south west) {for humans who skim};
  \end{tikzpicture}}
\newcommand\coverchip[2]{\tikz[baseline=(c.base)]\node[draw=vteal!70,line width=0.6pt,rounded corners=8pt,
  text=white,font=\footnotesize\semibold,inner xsep=7pt,inner ysep=4pt](c){{\color{vteal}#1}\enspace #2};}

